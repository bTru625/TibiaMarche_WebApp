@model TibiaMarche_WebApp.Models.ViewModels.AccountViewModel
@using TibiaMarche_WebApp.Models
@*
    S3 Account page (/Account). Click listeners: wwwroot/js/account.js.
    Buyers: currency (saves as soon as it changes), change password, change email.
    Admins: no currency section (they work in CAD only).
*@

<h1>Account</h1>
<hr />

<p>Signed in as <strong>@Model.Email</strong> @if (Model.IsAdmin) { <span class="tm-badge-rare">Admin</span> }</p>

<div class="tm-account-layout">

    @if (!Model.IsAdmin)
    {
        <section class="card" aria-labelledby="acc-currency">
            <div class="card-body">
                <h2 id="acc-currency" class="h4">Currency</h2>
                <p class="tm-muted">Prices are listed in CAD. You will see (and pay) in the currency you pick.</p>
                <form method="post" asp-controller="Account" asp-action="SetCurrency" id="currency-form">
                    <label for="currency-select" class="form-label">Show prices in</label>
                    <select name="currency" id="currency-select" class="form-select">
                        @foreach (Currency currency in Enum.GetValues<Currency>())
                        {
                            <option value="@currency" selected="@(currency == Model.Currency)">@currency (@currency.DisplayName())</option>
                        }
                    </select>
                </form>
                <p class="mt-2 mb-0" id="currency-example">@Model.ExamplePrice</p>
            </div>
        </section>
    }

    <section class="card" aria-labelledby="acc-password">
        <div class="card-body">
            <h2 id="acc-password" class="h4">Change password</h2>
            <form method="post" asp-controller="Account" asp-action="ChangePassword" id="password-form" novalidate>
                <div class="mb-3">
                    <label for="old-password" class="form-label">Current password</label>
                    <input type="password" name="oldPassword" id="old-password" class="form-control" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label for="new-password" class="form-label">New password</label>
                    <input type="password" name="newPassword" id="new-password" class="form-control" autocomplete="new-password" aria-describedby="password-hint" />
                    <div id="password-hint" class="form-text tm-muted">At least 6 characters.</div>
                </div>
                <div class="mb-3">
                    <label for="confirm-password" class="form-label">Confirm new password</label>
                    <input type="password" name="confirmPassword" id="confirm-password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="text-danger mb-2" id="password-error" role="alert"></div>
                <button type="button" class="btn btn-primary" id="password-save-btn">Set password</button>
            </form>
        </div>
    </section>

    <section class="card" aria-labelledby="acc-email">
        <div class="card-body">
            <h2 id="acc-email" class="h4">Change email</h2>
            <p class="tm-muted">We'll send a confirmation link to the new address. Your email changes after you confirm it.</p>
            <form method="post" asp-controller="Account" asp-action="ChangeEmail" id="email-form" novalidate>
                <div class="mb-3">
                    <label for="email-password" class="form-label">Password</label>
                    <input type="password" name="password" id="email-password" class="form-control" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label for="new-email" class="form-label">New email</label>
                    <input type="email" name="newEmail" id="new-email" class="form-control" autocomplete="email" />
                </div>
                <div class="text-danger mb-2" id="email-error" role="alert"></div>
                <button type="button" class="btn btn-primary" id="email-save-btn">Change email</button>
            </form>
        </div>
    </section>

    <section class="card" aria-labelledby="acc-logout">
        <div class="card-body">
            <h2 id="acc-logout" class="h4">Log out</h2>
            @* TODO(J - S2 "[Web] Auth"): point this form at J's one and only Logout action (a POST) once it
               exists, e.g. asp-controller="Auth" asp-action="Logout". It must stay a POST with the antiforgery token. *@
            <form method="post" action="/Auth/Logout" id="logout-form">
                <button type="button" class="btn btn-outline-secondary" id="logout-btn">Log out</button>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/account.js" asp-append-version="true"></script>
}
