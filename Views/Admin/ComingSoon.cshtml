<div class="tm-coming-soon">
    <h1>@ViewData["Title"]</h1>
    <div class="card">
        <div class="card-body">
            <span class="tm-badge-rare">Coming in @ViewData["Sprint"]</span>
            <p class="tm-coming-soon-text">@ViewData["Description"]</p>
        </div>
    </div>
</div>
