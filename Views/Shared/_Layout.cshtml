@inject TibiaMarche_WebApp.Services.Auth.ICurrentUser CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TibiMarché</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TibiaMarche_WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // The admin gets the admin navbar (logo, Items, Requests, Deliveries,
        // Maintenance); visitors and buyers get the buyer navbar.
        // The role comes from the login cookie (AccountController.SignInAsync).
        bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Admin);
        // Each admin page sets ViewData["AdminSection"] so its link is highlighted.
        string adminSection = ViewData["AdminSection"] as string ?? "";
        string AdminActive(string section) => adminSection == section ? "active" : "";
        string? AdminCurrent(string section) => adminSection == section ? "page" : null;
        // Where the guest Login link sends the user back to after logging in (a local path only).
        string returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
    }
    <header>
        @if (isAdmin)
        {
            @* ===== S4: admin navbar. Three parts: page links | DEV role switcher (middle) | account links.
               The two link lists share the free width equally (.tm-nav-side), which keeps the switcher in the middle. ===== *@
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm tm-admin-nav mb-3" aria-label="Admin">
                <div class="container-fluid">
                    @* TODO: swap the text for the logo image once it is designed. *@
                    @* The logo opens the admin start page: All Items (/Admin). *@
                    <a class="navbar-brand" asp-area="" asp-controller="Admin" asp-action="Index">Tibi<span class="tm-brand-accent">Marché</span><span class="tm-admin-tag">ADMIN</span></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex">
                        <ul class="navbar-nav tm-nav-side">
                            <li class="nav-item">
                                <a class="nav-link @AdminActive("Items")" aria-current="@AdminCurrent("Items")" asp-area="" asp-controller="Admin" asp-action="Index">Items</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @AdminActive("Requests")" aria-current="@AdminCurrent("Requests")" asp-area="" asp-controller="Admin" asp-action="Requests">Requests</a>
                            </li>
                            <li class="nav-item">
                                @* TODO(S7 "[Web] Admin: orders, sale alerts, mark delivered"):
                                   Sold items waiting for in-game delivery (target: within 1 hour), grouped
                                   by character, with "Mark delivered". Currently a placeholder (AdminController.Deliveries). *@
                                <a class="nav-link @AdminActive("Deliveries")" aria-current="@AdminCurrent("Deliveries")" asp-area="" asp-controller="Admin" asp-action="Deliveries">Deliveries</a>
                            </li>
                            <li class="nav-item">
                                @* TODO(J - S8 "Maintenance mode"): start and stop the daily maintenance
                                   (Available and In Cart items become Maintenance, carts are emptied,
                                   no orders while active). Currently a placeholder (AdminController.Maintenance). *@
                                <a class="nav-link @AdminActive("Maintenance")" aria-current="@AdminCurrent("Maintenance")" asp-area="" asp-controller="Admin" asp-action="Maintenance">Maintenance</a>
                            </li>
                        </ul>
                        @* TODO(DEV ONLY - DELETE BEFORE RELEASE): developer role switcher (guest / user / admin).
                           Delete this line, Views/Shared/_DevRoleSwitcher.cshtml, Controllers/DevRoleController.cs,
                           wwwroot/js/dev-role.js, the .tm-dev-switch CSS, and the cookie branch in CurrentUser.cs. *@
                        <partial name="_DevRoleSwitcher" />
                        <ul class="navbar-nav tm-nav-side tm-nav-end">
                            <li class="nav-item">
                                @* Account page: change password and email (no currency section, admins work
                                   in CAD only). *@
                                <a class="nav-link @AdminActive("Account")" aria-current="@AdminCurrent("Account")" asp-area="" asp-controller="Account" asp-action="Index">Account</a>
                            </li>
                            <li class="nav-item">
                                @* Log out is a POST form with an antiforgery token (logging out must not be a GET link).
                                   TODO(J - S2 "[Web] Auth: register, login, logout, guest browsing"): /Account/Logout is J's one
                                   and only Logout action; it clears the auth cookie and returns to Home. *@
                                <form method="post" action="/Account/Logout" asp-antiforgery="true" class="tm-nav-form">
                                    <button type="submit" class="nav-link tm-nav-button">Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }
        else
        {
            @* ===== Buyer / guest navbar. Three parts: page links | DEV role switcher (middle) | account links.
               Guest: logo, Login, Register only (no page links). Buyer: Home, Request an item | Cart, Account, Log out. ===== *@
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    @* Home page = the catalogue: every Available item, guests can browse. *@
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Tibi<span class="tm-brand-accent">Marché</span></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex">
                        @if (CurrentUser.IsAuthenticated)
                        {
                        <ul class="navbar-nav tm-nav-side">
                            <li class="nav-item">
                                @* TODO(J - Catalog): Home shows all Available items with search and
                                   filters (vocation, level, price). *@
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                @* Request an out-of-stock item (item name + server). Guests fill it in,
                                   then get the login page when they submit, and return here. *@
                                <a class="nav-link" asp-area="" asp-controller="Request" asp-action="Index">Request an item</a>
                            </li>
                        </ul>
                        }
                        else
                        {
                            @* Guest: no page links (no Home, no Request an item). The empty list keeps the
                               DEV switcher in the middle. *@
                            <ul class="navbar-nav tm-nav-side"></ul>
                        }
                        @* TODO(DEV ONLY - DELETE BEFORE RELEASE): developer role switcher (guest / user / admin).
                           Delete this line, Views/Shared/_DevRoleSwitcher.cshtml, Controllers/DevRoleController.cs,
                           wwwroot/js/dev-role.js, the .tm-dev-switch CSS, and the cookie branch in CurrentUser.cs. *@
                        <partial name="_DevRoleSwitcher" />
                        <ul class="navbar-nav tm-nav-side tm-nav-end">
                            @* TODO(auth - J S2): CurrentUser is the signed-in cookie user. Until login exists it is
                               always signed out, except in Development with Dev:FallbackRole set. *@
                            @if (CurrentUser.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    @* TODO(J - Cart): the buyer's cart (locked items, total in the buyer's
                                       currency, checkout with a deliver-to character per item). Placeholder until
                                       the Cart page exists: make this a real link then.
                                       Optional: badge with the number of items. *@
                                    <a class="nav-link disabled" aria-disabled="true" tabindex="-1" title="The cart is coming in a later sprint">Cart</a>
                                </li>
                                <li class="nav-item">
                                    @* Account page: currency (saves right away, shows an example converted
                                       price), change password, change email. *@
                                    <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Index">Account</a>
                                </li>
                                <li class="nav-item">
                                    @* Log out is a POST form with an antiforgery token (logging out must not be a GET link).
                                       TODO(J - S2 "[Web] Auth: register, login, logout, guest browsing"): /Account/Logout is J's one
                                       and only Logout action; it clears the auth cookie and returns to Home. *@
                                    <form method="post" action="/Account/Logout" asp-antiforgery="true" class="tm-nav-form">
                                        <button type="submit" class="nav-link tm-nav-button">Log out</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    @* TODO(J - S2 "[Web] Auth: register, login, logout, guest browsing"): /Account/Login is J's
                                       login page. returnUrl is the page the guest is on (a local path only), so they come back to it. *@
                                    <a class="nav-link" href="/Account/Login?returnUrl=@returnUrl">Login</a>
                                </li>
                                <li class="nav-item">
                                    @* TODO(J - S2): /Account/Register is J's register page (email + password; new accounts are buyers). *@
                                    <a class="nav-link" href="/Account/Register">Register</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Flash" />
            @if (TempData["Message"] is string message)
            {
                <div class="tm-alert tm-alert-success">@message</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TibiMarché - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>